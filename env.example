# =============================================================================
#  Vaultwarden en Railway — variables de entorno
#
#  Copia estos valores a las Variables del servicio en Railway.
#  NO subas este archivo relleno a GitHub: es solo una referencia.
#
#  Las marcadas [OBLIGATORIA] deben estar antes del primer deploy.
# =============================================================================

# --- Vaultwarden ------------------------------------------------------------

# [OBLIGATORIA] URL pública del servicio.
# DEBE llevar https:// y NO debe llevar comillas ni barra final.
# Sin el protocolo, Vaultwarden no arranca.
DOMAIN=https://tu-servicio.up.railway.app

# Puerto interno. Debe coincidir con el target port del dominio generado.
ROCKET_PORT=8080

# Ponlo a true SOLO para crear tu cuenta. Cámbialo a false inmediatamente después.
SIGNUPS_ALLOWED=true

# Permite invitar usuarios a la organización (requiere SMTP configurado).
INVITATIONS_ALLOWED=true

# Limita quién puede crear organizaciones. Pon tu email.
ORG_CREATION_USERS=tu@email.com

# Panel de administración. OPCIONAL: si no lo necesitas, no pongas la variable.
# Genera el hash con:  docker run --rm -it vaultwarden/server /vaultwarden hash
# NUNCA pongas el token en texto plano.
# ADMIN_TOKEN=$argon2id$v=19$...

# --- Backups a Cloudflare R2 ------------------------------------------------

# [OBLIGATORIA] Clave PÚBLICA de age (empieza por age1...).
# Genérala con:  age-keygen -o backup-key.txt
# La clave PRIVADA NO va aquí: guárdala fuera (papel, USB).
AGE_RECIPIENT=age1...

# [OBLIGATORIA] Credenciales del token de R2.
# Al crear el token, Cloudflare muestra TRES valores.
# Necesitas el "Access Key ID" (32 caracteres hex) y el "Secret Access Key".
# El "Token Value" NO sirve para el protocolo S3 y produce un 403.
S3_KEY=
S3_SECRET=

# [OBLIGATORIA] Nombre del bucket de R2.
S3_BUCKET=

# Carpeta dentro del bucket. Útil si guardas varias instancias en el mismo sitio.
S3_PREFIX=vw

# [OBLIGATORIA] Endpoint de R2. El ACCOUNT_ID está en la barra lateral de R2.
# Sin barra final y sin el nombre del bucket dentro.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Ping URL de healthchecks.io. Avisa por email si un backup deja de subir.
# Muy recomendable: el fallo típico es que los backups fallen en silencio.
HC_URL=https://hc-ping.com/UUID

# Intervalo entre backups, en segundos. 21600 = 6 horas.
BACKUP_INTERVAL=21600

# --- Correo (vía relay SMTP) ------------------------------------------------
#
# Railway bloquea el SMTP saliente en los planes Free/Trial/Hobby.
# Por eso hace falta el servicio relay, que traduce SMTP -> API HTTPS.
# Si estás en plan Pro, puedes apuntar directamente a tu proveedor SMTP.

SMTP_HOST=nombre-del-relay.railway.internal
SMTP_PORT=2525
SMTP_SECURITY=off
SMTP_FROM=vault@tudominio.com
SMTP_FROM_NAME=Vaultwarden
SMTP_EMBED_IMAGES=false

# --- Restauración -----------------------------------------------------------
#
# Estas DOS variables solo se ponen durante una recuperación, y se BORRAN
# inmediatamente después. Ver el apartado "Recuperación" del README.
#
# Mientras AGE_IDENTITY esté aquí, la clave privada vive en el mismo sitio
# que los backups y el cifrado deja de protegerte.

# RESTORE_FROM=latest
# AGE_IDENTITY=AGE-SECRET-KEY-1...
